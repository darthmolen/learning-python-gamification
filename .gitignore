__pycache__/
*.pyc

node_modules/
dist/
# Generator scratch output. `dist/` alone does not match these, and a test that writes
# beside its own source will otherwise commit its output.
dist-test/
dist-broken-out/
*.tsbuildinfo

.env
.env.local

# Agent worktrees. Sub-agents run in isolated checkouts under here; each is a
# full copy of the repository (154MB for three) and none of it belongs in history.
# The branches are the durable artifact -- the checkouts are scratch.
.claude/worktrees/

# Scratch space for reading other people's repositories -- a learner's clone lands here
# so it can be read without its history becoming part of THIS repository's history.
research/
