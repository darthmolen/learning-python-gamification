{
  "name": "@pyquest/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "tsc -b && node dist/cli.js",
    "seed": "tsc -b && node dist/seed.js",
    "seed:reset": "tsc -b && node dist/seed.js --reset",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@pyquest/content": "*",
    "@pyquest/contract": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
