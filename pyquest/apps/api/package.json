    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pyquest/content": "*",
    "@pyquest/contract": "*",
    "@pyquest/db": "*",
    "@pyquest/engine": "*",
    "fastify": "^5.2.0",
    "pg": "^8.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
