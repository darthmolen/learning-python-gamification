{
  "name": "@pyquest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The PyQuest API. Serves @pyquest/contract, runs the four verifiers of §6.3.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "tsc -b ../.. && node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
